{
  "expo": {
    "name": "냠픽",
    "slug": "nyampick",
    "version": "1.0.0",
    "scheme": "nyampick",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.nyampick.app",
      "buildNumber": "1",
      "usesAppleSignIn": false,
      "infoPlist": {
        "CFBundleName": "냠픽",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kr.nyampick.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "냠픽이 영수증 사진을 촬영해 냉장고 재료를 등록할 수 있도록 카메라 접근을 허용해주세요.",
          "photosPermission": "냠픽이 프로필·아이 사진과 영수증 사진을 선택할 수 있도록 사진 접근을 허용해주세요.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
